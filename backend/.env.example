APP_NAME="AI Lead Generation Platform"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=["http://localhost:5173"]

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/leadgen
DIRECT_DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Enable Places API (New) and billing for this key in Google Cloud Console.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GEMINI_API_KEY=your-gemini-api-key

# Email verification (use your transactional email provider's SMTP credentials)
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
